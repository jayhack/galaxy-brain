# Vercel Sandbox authentication.
# In production, Vercel OIDC is automatic for linked projects.
# Locally, `vercel env pull` can provide VERCEL_OIDC_TOKEN. Alternatively,
# provide VERCEL_TOKEN plus the linked team/project IDs below.
VERCEL_OIDC_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Repository to clone inside the sandbox. Use the HTTPS Git URL.
GALAXY_BRAIN_REPO_URL=https://github.com/jayhack/galaxy-brain.git
GALAXY_BRAIN_BASE_BRANCH=main

# Optional local prompt source for dry runs. Defaults to the current repo.
GALAXY_BRAIN_LOCAL_REPO_PATH=.

# Agent provider keys forwarded into the sandbox.
OPENAI_API_KEY=
# Optional explicit Codex CLI key; defaults to OPENAI_API_KEY when unset.
CODEX_API_KEY=
CURSOR_API_KEY=
ANTHROPIC_API_KEY=

# Required for pushing branches and opening draft PRs.
GITHUB_TOKEN=

# Optional git identity used for orchestrator commits.
GIT_AUTHOR_NAME=galaxy-brain solver
GIT_AUTHOR_EMAIL=solver@users.noreply.github.com

# Optional default sandbox/poll tuning.
SOLVER_SANDBOX_TIMEOUT_MS=7200000
SOLVER_POLL_INTERVAL_MS=60000

# Optional local CLI endpoint override for `gx run`.
GX_API_URL=http://127.0.0.1:3000

# Optional server-side run history store.
# SUPABASE_SERVICE_ROLE_KEY must stay server-only; never expose it as NEXT_PUBLIC_*.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional coarse cost estimate when the agent output includes total token usage.
# You can set a global price, or model-specific e.g. SOLVER_COST_USD_PER_1M_TOKENS_GPT_5_4_MINI.
SOLVER_COST_USD_PER_1M_TOKENS=

# Copy this file to the REPO ROOT as `.env` (it is gitignored) and fill in keys.
# The solver also reads solver/.env if you prefer to keep it local to the tool.

# --- Daytona (required) -------------------------------------------------------
DAYTONA_API_KEY=
# Optional Daytona overrides:
# DAYTONA_API_URL=
# DAYTONA_TARGET=us
# DAYTONA_ORGANIZATION_ID=

# --- Agent API keys (only the one for the harness you use is required) --------
OPENAI_API_KEY=        # --harness codex
CURSOR_API_KEY=        # --harness cursor
ANTHROPIC_API_KEY=     # --harness claude

# --- GitHub (required to push the branch and open the PR) ---------------------
# A token with `repo`/`pull request` write access to the galaxy-brain repo.
GITHUB_TOKEN=

# --- Commit identity (optional) ----------------------------------------------
# GIT_AUTHOR_NAME=galaxy-brain-solver
# GIT_AUTHOR_EMAIL=galaxy-brain-solver@users.noreply.github.com

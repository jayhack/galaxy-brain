# Vercel Sandbox authentication.
# In production, Vercel OIDC is automatic for linked projects.
# For local sandbox runs, provide all three values below.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=

# Repository to clone inside the sandbox. Use the HTTPS Git URL.
GALAXY_BRAIN_REPO_URL=https://github.com/jayhack/galaxy-brain.git
GALAXY_BRAIN_BASE_BRANCH=main

# Optional local prompt source for dry runs. Defaults to the parent directory
# when running this app from workflow-app/.
GALAXY_BRAIN_LOCAL_REPO_PATH=..

# Agent provider keys forwarded into the sandbox.
OPENAI_API_KEY=
CURSOR_API_KEY=
ANTHROPIC_API_KEY=

# Required for pushing branches and opening draft PRs.
GITHUB_TOKEN=

# Optional git identity used for orchestrator commits.
GIT_AUTHOR_NAME=galaxy-brain solver
GIT_AUTHOR_EMAIL=solver@users.noreply.github.com

# Optional default sandbox/poll tuning.
SOLVER_SANDBOX_TIMEOUT_MS=7200000
SOLVER_POLL_INTERVAL_MS=60000
